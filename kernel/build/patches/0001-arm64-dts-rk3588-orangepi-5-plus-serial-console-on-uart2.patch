--- a/arch/arm64/boot/dts/rockchip/rk3588-orangepi-5-plus.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588-orangepi-5-plus.dts
@@ -1338,3 +1338,17 @@
 &tsadc {
     status = "okay";
 };
+
+/*
+ * Talos: a plain 8250 console on UART2 (console=ttyS2,1500000) instead of the
+ * vendor FIQ debugger, which the Talos kernel does not build.
+ */
+&fiq_debugger {
+	status = "disabled";
+};
+
+&uart2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart2m0_xfer>;
+	status = "okay";
+};
