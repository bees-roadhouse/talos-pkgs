+// generateDTB embeds a device tree in the UKI's .dtb section when
+// ROADHOUSE_UKI_DTB names one (Bee's Roadhouse talos-pkgs, brh-infra#442).
+// systemd-stub installs it as the FDT for this UKI only, so a kernel that
+// needs its own device tree (the Rockchip BSP kernel) gets it without
+// replacing the single dtb u-boot hands to every boot entry from the EFI
+// partition, and an A/B rollback to a mainline entry still boots on the
+// mainline dtb. Unset, nothing changes.
+func (builder *Builder) generateDTB() error {
+	path := os.Getenv("ROADHOUSE_UKI_DTB")
+	if path == "" {
+		return nil
+	}
+
+	if _, err := os.Stat(path); err != nil {
+		return fmt.Errorf("ROADHOUSE_UKI_DTB: %w", err)
+	}
+
+	builder.sections = append(
+		builder.sections,
+		section{
+			Name:    SectionDTB.String(),
+			Path:    path,
+			Measure: true,
+			Append:  true,
+		},
+	)
+
+	return nil
+}
